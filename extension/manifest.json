{
  "manifest_version": 3,
  "name": "DSH Chrome Bridge",
  "version": "0.1.1",
  "description": "Lets DeepSeek Harness agents operate your signed-in Chrome tabs — with your approval. Requires the dsh-chrome-bridge plugin in DSH.",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "downloads",
    "history",
    "bookmarks",
    "sessions",
    "topSites",
    "notifications",
    "contextMenus",
    "favicon",
    "webNavigation",
    "scripting",
    "sidePanel",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "cursor.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-dsh-side-panel": {
      "description": "Open DSH Chrome Bridge side panel",
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      }
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "DSH Chrome Bridge",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/cursor-chat.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
